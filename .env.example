# Copy to .env and adjust. All values are optional; defaults shown.

# --- server ---
MULTI_AI_HOST=127.0.0.1
MULTI_AI_PORT=8000
# Set a token to require auth on /api/* and /ws/* (recommended if not localhost-only)
# MULTI_AI_AUTH_TOKEN=change-me-long-random-string
MULTI_AI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- backends ---
OLLAMA_HOST=http://localhost:11434
DEEPSEEK_BASE=https://api.deepseek.com
OPENAI_BASE=https://api.openai.com/v1

# --- hardware thresholds (percent) ---
GPU_VRAM_WARN_PERCENT=80
GPU_VRAM_CRITICAL_PERCENT=90
RAM_WARN_PERCENT=85
CPU_WARN_PERCENT=90

# --- model defaults ---
CLOUD_MODEL=deepseek-chat
LOCAL_MODEL=llama3.2
CODING_MODEL=deepseek-coder
FALLBACK_MODEL=llama3.2:1b

# --- sandbox limits ---
SANDBOX_MEM_MB=512
SANDBOX_CPU_SECONDS=30
SANDBOX_WALL_SECONDS=60
MAX_OUTPUT_CHARS=200000
MAX_PROMPT_CHARS=32000
MAX_FILE_BYTES=1000000

# --- storage ---
# MULTI_AI_DATA_DIR=./data
# MULTI_AI_WORKSPACE_DIR=./workspace
